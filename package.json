{
  "name": "fleetfail",
  "version": "0.1.0",
  "private": true,
  "description": "Resilient Dispatch Simulator - Synthetic residential battery fleet orchestrator",
  "scripts": {
    "dev": "pnpm --filter @fleetfail/web dev",
    "build": "pnpm --filter @fleetfail/engine build && pnpm --filter @fleetfail/web build",
    "test": "pnpm --filter @fleetfail/engine test",
    "test:watch": "pnpm --filter @fleetfail/engine test:watch",
    "lint": "pnpm --filter '*' lint",
    "typecheck": "pnpm --filter '*' typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.33.3"
}
