# ERCOT Public API Credentials
# Documentation: https://www.ercot.com/services/api
#
# These credentials are required to fetch live ERCOT data.
# Without them, the system falls back to the fixture dataset (Sep 2024).
#
# IMPORTANT: Never commit real credentials to the repository.
#
# LOCAL DEVELOPMENT:
#   Copy this file to apps/web/.env.local (NOT repo root or packages/engine/)
#   The Next.js app only reads env vars from apps/web/.env.local
#
#   cp .env.example apps/web/.env.local
#
#   Restart `pnpm dev` after changing env vars.

# ERCOT B2C username (email address registered with ERCOT)
ERCOT_API_USERNAME=

# ERCOT B2C password
ERCOT_API_PASSWORD=

# ERCOT Public API subscription key (from Azure API Management portal)
ERCOT_PUBLIC_API_SUBSCRIPTION_KEY=
